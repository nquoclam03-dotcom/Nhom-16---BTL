// Tráo đổi dữ liệu của 2 Node
void hoanViDuLieu(Node* a, Node* b) {
    SinhVien temp = a->data;
    a->data = b->data;
    b->data = temp;
}

// Hàm chia (partition) dùng cho QuickSort
Node* partition(Node* left, Node* right) {
    float pivot = right->data.diemGPA;
    Node* i = left->prev; 
    for (Node* j = left; j != right; j = j->next) {
        if (j->data.diemGPA >= pivot) {
            i = (i == NULL) ? left : i->next; 
            hoanViDuLieu(i, j);
        }
    }
    i = (i == NULL) ? left : i->next; 
    hoanViDuLieu(i, right);
    return i;
}

// Hàm QuickSort đệ quy
void _quickSort(Node* left, Node* right) {
    if (right != NULL && left != right && left != right->next) {
        Node* pivotNode = partition(left, right);
        _quickSort(left, pivotNode->prev);
        _quickSort(pivotNode->next, right);
    }
}

// Hàm gọi sắp xếp danh sách theo GPA giảm dần
void sapXepQuickSort(DoubleLinkedList &list) {
    if (list.head == NULL || list.head == list.tail) return;
    _quickSort(list.head, list.tail);
    cout << "Da sap xep danh sach theo GPA giam dan" << endl;
}
