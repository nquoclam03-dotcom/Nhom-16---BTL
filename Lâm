#include <iostream>
#include <string>
#include <fstream>
#include <sstream>
#include <iomanip>

using namespace std;

// Cấu trúc thông tin sinh viên
struct SinhVien {
    string maSV;
    string hoTen;
    float diemGPA;
    string xepLoai;
};

// Cấu trúc một Node trong danh sách liên kết đôi
struct Node {
    SinhVien data;
    Node* prev;
    Node* next;
};

// Cấu trúc Danh sách liên kết đôi
struct DoubleLinkedList {
    Node* head;
    Node* tail;
};

// Khởi tạo danh sách rỗng
void khoiTaoDanhSach(DoubleLinkedList &list) {
    list.head = NULL;
    list.tail = NULL;
}

// Phân loại học lực dựa trên điểm GPA
string phanLoaiHocLuc(float gpa) {
    if (gpa >= 3.6) return "Xuat sac";
    if (gpa >= 3.2) return "Gioi";
    if (gpa >= 2.5) return "Kha";
    if (gpa >= 2.0) return "Trung binh";
    return "Yeu";
}

// Tạo Node mới
Node* taoNode(SinhVien sv) {
    Node* pNode = new Node;
    if (pNode == NULL) return NULL;
    pNode->data = sv;
    pNode->prev = NULL;
    pNode->next = NULL;
    return pNode;
}
